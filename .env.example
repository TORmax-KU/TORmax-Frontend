# Copy this file to .env.local in this folder (only if it does not exist).
# Browser-accessible backend URL; use port 5001 for local Node or root Docker Compose.
# NEXT_PUBLIC_ values are visible to users: never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Hosting (e.g. Vercel): set NEXT_PUBLIC_API_URL=/backend and BACKEND_URL to the API address.
# The site then forwards /backend/... to the API so login cookies keep working. Leave unset locally.
# BACKEND_URL=https://your-api.onrender.com
